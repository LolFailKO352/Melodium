<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef ProductVersion?>
    <?define ProductVersion = "1.5.0.0" ?>
  <?endif?>

  <Package Name="Melodium"
           Manufacturer="Deeemon"
           Version="$(var.ProductVersion)"
           UpgradeCode="4F2B6699-317A-456E-857D-8F719E868D9A"
           Scope="perMachine"
           Codepage="65001">
    
    <!-- Nastavení aktualizace: vyhledání a upgrade předchozích verzí -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Novější verze aplikace Melodium je již nainstalována."
                  AllowSameVersionUpgrades="yes" />
    
    <!-- Bezpečné ukončení běžící instance Melodium před instalací či aktualizací -->
    <util:CloseApplication Id="CloseMelodium"
                           Target="Melodium.exe"
                           CloseMessage="yes"
                           Description="Probíhá bezpečné ukončení aplikace Melodium pro dokončení aktualizace..."
                           RebootPrompt="no"
                           TerminateProcess="1" />

    <!-- Kontrola existence předchozí instalace v registru (HKLM) a zjištění verze -->
    <Property Id="INSTALLED_VERSION_HKLM">
      <RegistrySearch Id="SearchInstalledVerHKLM"
                      Root="HKLM"
                      Key="Software\Deeemon\Melodium"
                      Name="Version"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- Kontrola existence předchozí instalace v registru (HKCU) a zjištění verze -->
    <Property Id="INSTALLED_VERSION_HKCU">
      <RegistrySearch Id="SearchInstalledVerHKCU"
                      Root="HKCU"
                      Key="Software\Deeemon\Melodium"
                      Name="Version"
                      Type="raw" />
    </Property>

    <!-- Zjištění původního instalačního adresáře z registru -->
    <Property Id="PREVIOUS_INSTALL_DIR">
      <RegistrySearch Id="SearchPrevInstallDir"
                      Root="HKLM"
                      Key="Software\Deeemon\Melodium"
                      Name="InstallDir"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- Kontrola existence spustitelného souboru na disku -->
    <Property Id="EXISTING_APP_FILE">
      <DirectorySearch Id="SearchProgramFiles" Path="[ProgramFiles64Folder]Melodium">
        <FileSearch Id="SearchMelodiumExe" Name="Melodium.exe" />
      </DirectorySearch>
    </Property>

    <!-- Pokud byl nalezen existující instalační adresář, automaticky jej použijeme pro aktualizaci -->
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUS_INSTALL_DIR]" After="AppSearch" Condition="PREVIOUS_INSTALL_DIR" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="Resources\Raw\trayicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Melodium" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Melodium" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents">
      <!-- Main Executable Component with Shortcuts -->
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="7B9C1E20-4286-4B8D-927A-4FF32E072051">
        <File Id="MelodiumExe" Source="publish\Melodium.exe" KeyPath="yes" />
        
        <!-- Start Menu Shortcut -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="Melodium"
                  Description="Moderní YouTube Music přehrávač"
                  Target="[#MelodiumExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />

        <!-- Desktop Shortcut -->
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Melodium"
                  Description="Moderní YouTube Music přehrávač"
                  Target="[#MelodiumExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
      </Component>

      <!-- Registrace informací o instalaci a verzi do registru pro budoucí kontroly a aktualizace -->
      <Component Id="RegistryVersionInfo" Directory="INSTALLFOLDER" Guid="A3E87920-5612-4D3E-91C0-33E59C77521F">
        <RegistryKey Root="HKLM" Key="Software\Deeemon\Melodium">
          <RegistryValue Name="Installed" Type="integer" Value="1" />
          <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Deeemon\Melodium">
          <RegistryValue Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        </RegistryKey>
      </Component>

      <!-- Start Menu Folder Cleanup -->
      <Component Id="CleanupShortcuts" Directory="ApplicationProgramsFolder" Guid="6A123C4D-5E6F-7890-ABCD-EF1234567890">
        <RemoveFolder Id="CleanProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Deeemon\Melodium" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Melodium" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="PublishedFiles" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
