<UserControl
    x:Class="Melodium.Controls.EqualizerBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel x:Name="BarsPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Border x:Name="Bar0" Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource MelodiumAccentBrush}" VerticalAlignment="Bottom" />
            <Border x:Name="Bar1" Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource MelodiumAccentBrush}" VerticalAlignment="Bottom" />
            <Border x:Name="Bar2" Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource MelodiumAccentBrush}" VerticalAlignment="Bottom" />
            <Border x:Name="Bar3" Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource MelodiumAccentBrush}" VerticalAlignment="Bottom" />
        </StackPanel>
    </Grid>
</UserControl>
