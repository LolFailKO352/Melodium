<Window
    x:Class="Melodium.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Melodium.Views"
    xmlns:tb="using:H.NotifyIcon"
    Title="Melodium 🎶">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Tray Icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Melodium"
            IconSource="Resources/Raw/trayicon.ico"
            MenuActivation="RightClick"
            ContextMenuMode="SecondWindow"
            DoubleClickCommand="{x:Bind ToggleWindowVisibilityCommand}"
            LeftClickCommand="{x:Bind ToggleWindowVisibilityCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Pozastavit / Přehrát" Click="OnTrayPlayPauseClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Zobrazit / Skrýt okno" Click="OnTrayShowHideClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE737;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Ukončit" Click="OnTrayExitClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <views:MainView x:Name="MainContent" />
    </Grid>
</Window>
