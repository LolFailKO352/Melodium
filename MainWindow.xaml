<Window
    x:Class="Melodium.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Melodium.Views"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:services="using:Melodium.Services"
    Title="Melodium 🎶">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Tray Icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Melodium"
            IconSource="Resources/Raw/trayicon.ico"
            MenuActivation="RightClick"
            ContextMenuMode="PopupMenu"
            DoubleClickCommand="{x:Bind ToggleWindowVisibilityCommand}"
            LeftClickCommand="{x:Bind ToggleWindowVisibilityCommand}" />

        <views:MainView x:Name="MainContent" />
    </Grid>
</Window>
