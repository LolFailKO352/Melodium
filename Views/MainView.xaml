<UserControl
    x:Class="Melodium.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Melodium.Views"
    xmlns:models="using:Melodium.Models"
    xmlns:viewmodels="using:Melodium.ViewModels"
    xmlns:converters="using:Melodium.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
        <converters:StringEqualsToVisibilityConverter x:Key="StringToVis" />
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
        <converters:BoolToDoubleConverter x:Key="BoolToLyricOpacity" TrueValue="1.0" FalseValue="0.38" />
        <converters:BoolToDoubleConverter x:Key="BoolToLyricFontSize" TrueValue="20.0" FalseValue="16.0" />
        <converters:BoolToVector3Converter x:Key="BoolToLyricScale" TrueScale="1.04" FalseScale="1.0" />
        <converters:BoolToThicknessConverter x:Key="BoolToLyricBorderThick" TrueValue="1.0" FalseValue="0.0" />

        <SolidColorBrush x:Key="MelodiumAccentBrush" Color="#28C6D0" />
        <SolidColorBrush x:Key="MelodiumCardBorderBrush" Color="#2D2F3C" />
        <SolidColorBrush x:Key="MelodiumMutedBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="MelodiumWhiteBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MelodiumTransparentBrush" Color="Transparent" />
        <SolidColorBrush x:Key="MelodiumTabActiveBgBrush" Color="#2E3040" />
        <SolidColorBrush x:Key="MelodiumLyricActiveBgBrush" Color="#2028C6D0" />
        <SolidColorBrush x:Key="MelodiumLyricActiveBorderBrush" Color="#4428C6D0" />

        <converters:BoolToBrushConverter x:Key="BoolToLyricBrush" TrueBrush="{StaticResource MelodiumAccentBrush}" FalseBrush="{StaticResource MelodiumMutedBrush}" />
        <converters:BoolToBrushConverter x:Key="BoolToLyricBg" TrueBrush="{StaticResource MelodiumLyricActiveBgBrush}" FalseBrush="{StaticResource MelodiumTransparentBrush}" />
        <converters:BoolToBrushConverter x:Key="BoolToLyricBorder" TrueBrush="{StaticResource MelodiumLyricActiveBorderBrush}" FalseBrush="{StaticResource MelodiumTransparentBrush}" />

        <converters:BoolToBrushConverter x:Key="BoolToQueueTabBg" TrueBrush="{StaticResource MelodiumTransparentBrush}" FalseBrush="{StaticResource MelodiumTabActiveBgBrush}" />
        <converters:BoolToBrushConverter x:Key="BoolToQueueTabFg" TrueBrush="{StaticResource MelodiumMutedBrush}" FalseBrush="{StaticResource MelodiumWhiteBrush}" />
        <converters:BoolToBrushConverter x:Key="BoolToLyricsTabBg" TrueBrush="{StaticResource MelodiumLyricActiveBgBrush}" FalseBrush="{StaticResource MelodiumTransparentBrush}" />
        <converters:BoolToBrushConverter x:Key="BoolToLyricsTabFg" TrueBrush="{StaticResource MelodiumAccentBrush}" FalseBrush="{StaticResource MelodiumMutedBrush}" />

        <Style x:Key="MediaCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <!-- Main Content Grid -->
    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Custom TitleBar drag area -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="40" Background="Transparent" ColumnDefinitions="Auto, *, Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image Source="Resources/Raw/trayicon.png" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="Melodium" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Middle Section: Navigation & Views -->
        <Grid Grid.Row="1">
            <NavigationView
                x:Name="NavView"
                PaneDisplayMode="LeftCompact"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                SelectionChanged="NavView_SelectionChanged"
                OpenPaneLength="200"
                CompactPaneLength="56">
                
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="{x:Bind ViewModel.TextHome, Mode=OneWay}" Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="{x:Bind ViewModel.TextLibrary, Mode=OneWay}" Tag="Library">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem x:Name="AccountNavItem"
                                        Content="{x:Bind ViewModel.TextAccount, Mode=OneWay}"
                                        Tag="Login"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.UserAccountTooltip, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.UserProfileName, Mode=OneWay}" IsEnabled="False" Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <MenuFlyoutItem Text="{x:Bind ViewModel.TextLogout, Mode=OneWay}" Icon="Cancel" Command="{x:Bind ViewModel.LogoutCommand}" Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <MenuFlyoutItem Text="Přihlásit se" Icon="Contact" Click="OnGoToLoginClick" Visibility="{x:Bind ViewModel.IsNotLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </MenuFlyout>
                        </NavigationViewItem.ContextFlyout>
                    </NavigationViewItem>
                    <NavigationViewItem Content="{x:Bind ViewModel.TextSettings, Mode=OneWay}" Tag="Settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <!-- Content Header with Global Search -->
                <Grid RowDefinitions="Auto, *" Padding="24,8,24,0">
                    
                    <!-- Top Bar: Search Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            PlaceholderText="{x:Bind ViewModel.TextSearchPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                            QueryIcon="Find"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            TextChanged="SearchBox_TextChanged"
                            HorizontalAlignment="Center"
                            Width="540"
                            CornerRadius="20" />
                    </Grid>

                    <!-- VIEWS CONTAINER -->
                    <Grid Grid.Row="1">

                        <!-- VIEW: HOME -->
                        <ScrollViewer Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Home'}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="28" Padding="0,0,0,32">
                                
                                <!-- Personalized Recommendations -->
                                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasPersonalizedRecommendations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.TextPersonalizedSongs, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.LibraryBasedRecommendations, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="280" MinItemHeight="90" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:SongModel">
                                                <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnSongCardClick">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                                            <MenuFlyoutItem Text="Spustit mix" Icon="Audio" CommandParameter="{x:Bind}" Click="OnSongContextStartMixClick" />
                                                            <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                                            <MenuFlyoutItem Text="Přidat do fronty" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToQueueClick" />
                                                            <MenuFlyoutItem Text="Přidat do playlistu" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToPlaylistClick" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Grid ColumnDefinitions="70, *">
                                                        <Border Grid.Column="0" CornerRadius="6">
                                                            <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="70" Height="70" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Tapped="OnSongArtistTapped" Tag="{x:Bind}" ToolTipService.ToolTip="Přejít na autora" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- Explore / Recommended Music -->
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{x:Bind ViewModel.TextRecommendedMusic, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                                    
                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" Height="3" />

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.HomeRecommendations, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="280" MinItemHeight="90" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:SongModel">
                                                <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnSongCardClick">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                                            <MenuFlyoutItem Text="Spustit mix" Icon="Audio" CommandParameter="{x:Bind}" Click="OnSongContextStartMixClick" />
                                                            <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                                            <MenuFlyoutItem Text="Přidat do fronty" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToQueueClick" />
                                                            <MenuFlyoutItem Text="Přidat do playlistu" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToPlaylistClick" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Grid ColumnDefinitions="70, *">
                                                        <Border Grid.Column="0" CornerRadius="6">
                                                            <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="70" Height="70" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Tapped="OnSongArtistTapped" Tag="{x:Bind}" ToolTipService.ToolTip="Přejít na autora" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW: SEARCH RESULTS -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Search'}" RowDefinitions="Auto, Auto, *">
                            <!-- Search Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Výsledky vyhledávání" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.SearchQuery, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnBackToHomeClick" Background="Transparent" BorderBrush="Transparent" Padding="10,6" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                        <TextBlock Text="Zpět domů" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" Height="3" Margin="0,0,0,16" />
                            
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <!-- Empty state -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,48,0,0" Visibility="{x:Bind ViewModel.IsSearchResultsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE721;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Nebyly nalezeny žádné skladby" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Zkuste vyhledat jiného interpreta nebo název skladby." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Search Results items matching Home design -->
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="280" MinItemHeight="86" MinRowSpacing="10" MinColumnSpacing="10" Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:SongModel">
                                                <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnSongCardClick">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                                            <MenuFlyoutItem Text="Spustit mix" Icon="Audio" CommandParameter="{x:Bind}" Click="OnSongContextStartMixClick" />
                                                            <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                                            <MenuFlyoutItem Text="Přidat do fronty" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToQueueClick" />
                                                            <MenuFlyoutItem Text="Přidat do playlistu" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToPlaylistClick" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Grid ColumnDefinitions="70, *">
                                                        <Border Grid.Column="0" CornerRadius="6">
                                                            <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="70" Height="70" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Tapped="OnSongArtistTapped" Tag="{x:Bind}" ToolTipService.ToolTip="Přejít na autora" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- VIEW: LIBRARY -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Library'}">
                            
                            <!-- Not Logged In State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Visibility="{x:Bind ViewModel.IsNotLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <FontIcon Glyph="&#xE8F1;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TextLockedLibrary, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TextLockedLibraryDesc, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" MaxWidth="360" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                <Button Content="{x:Bind ViewModel.TextGoToLogin, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Click="OnGoToLoginClick" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Logged In State -->
                            <Grid RowDefinitions="Auto, Auto, *" Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <!-- Header and Tabs -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,16">
                                    <TextBlock Text="{x:Bind ViewModel.TextMusic, Mode=OneWay}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Action Bar: Shuffle, Tabs -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,0,0,16">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <Button Command="{x:Bind ViewModel.ShuffleAndPlayLibraryCommand}" Style="{ThemeResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                                <TextBlock Text="{x:Bind ViewModel.TextShuffleAndPlay, Mode=OneWay}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Segmented Tab Selection -->
                                        <RadioButtons SelectedIndex="0" SelectionChanged="OnLibraryTabSelectionChanged" MaxColumns="4">
                                            <RadioButton Content="{x:Bind ViewModel.TextSongs, Mode=OneWay}" Tag="Songs" />
                                            <RadioButton Content="{x:Bind ViewModel.TextPlaylists, Mode=OneWay}" Tag="Playlists" />
                                            <RadioButton Content="{x:Bind ViewModel.TextAlbums, Mode=OneWay}" Tag="Albums" />
                                            <RadioButton Content="{x:Bind ViewModel.TextArtists, Mode=OneWay}" Tag="Artists" />
                                        </RadioButtons>
                                    </StackPanel>
                                </Grid>

                                <!-- Tab Contents -->
                                <Grid Grid.Row="2">
                                    <!-- Songs Tab -->
                                    <ListView ItemsSource="{x:Bind ViewModel.LibrarySongs, Mode=OneWay}"
                                              SelectionMode="Single"
                                              ItemClick="OnSongListItemClick"
                                              IsItemClickEnabled="True"
                                              Visibility="{x:Bind ViewModel.LibraryTab, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Songs'}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SongModel">
                                                <Grid ColumnDefinitions="48, *, Auto" Margin="0,3" VerticalAlignment="Center">
                                                    <Grid.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                                            <MenuFlyoutItem Text="Spustit mix" Icon="Audio" CommandParameter="{x:Bind}" Click="OnSongContextStartMixClick" />
                                                            <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                                            <MenuFlyoutItem Text="Přidat do fronty" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToQueueClick" />
                                                            <MenuFlyoutItem Text="Přidat do playlistu" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToPlaylistClick" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                                        </MenuFlyout>
                                                    </Grid.ContextFlyout>
                                                    <Border Grid.Column="0" CornerRadius="6">
                                                        <Image Source="{x:Bind ThumbnailUrl}" Width="44" Height="44" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                        <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" Tapped="OnSongArtistTapped" Tag="{x:Bind}" ToolTipService.ToolTip="Přejít na autora" />
                                                    </StackPanel>
                                                    <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Playlists Tab -->
                                    <ScrollViewer Visibility="{x:Bind ViewModel.LibraryTab, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Playlists'}">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LibraryPlaylists, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="220" MinItemHeight="80" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlaylistModel">
                                                    <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnPlaylistCardClick">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Otevřít playlist" Icon="Folder" CommandParameter="{x:Bind}" Click="OnPlaylistCardClick" />
                                                                <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnPlaylistContextPlayClick" />
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="64, *">
                                                            <Border Grid.Column="0" CornerRadius="6">
                                                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="64" Height="64" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Creator}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                                    <TextBlock Text="{x:Bind SongCount}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="11" />
                                                                    <TextBlock Text="• Upravitelný" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="10" Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <!-- Albums Tab -->
                                    <ScrollViewer Visibility="{x:Bind ViewModel.LibraryTab, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Albums'}">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LibraryAlbums, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="220" MinItemHeight="80" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:AlbumModel">
                                                    <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnAlbumCardClick">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnAlbumContextPlayClick" />
                                                                <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnAlbumContextOpenArtistClick" />
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="64, *">
                                                            <Border Grid.Column="0" CornerRadius="6">
                                                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="64" Height="64" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ArtistName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                                <TextBlock Text="{x:Bind ReleaseYear}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <!-- Artists Tab -->
                                    <ScrollViewer Visibility="{x:Bind ViewModel.LibraryTab, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Artists'}">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LibraryArtists, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="200" MinItemHeight="70" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:ArtistModel">
                                                    <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnArtistCardClick">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Otevřít interpreta" Icon="Contact" CommandParameter="{x:Bind}" Click="OnArtistContextOpenClick" />
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="54, *">
                                                            <PersonPicture Grid.Column="0" DisplayName="{x:Bind Name}" Width="54" Height="54" />
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind SongCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- VIEW: SETTINGS -->
                        <ScrollViewer Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Settings'}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="24" Padding="0,0,0,32" MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TextSettings, Mode=OneWay}" FontSize="28" FontWeight="Bold" />

                                <!-- Language Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.TextLanguageSelection, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.TextLanguageDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        <ComboBox ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                                  DisplayMemberPath="NativeName"
                                                  Width="280" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Discord RPC Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TextEnableDiscordRpc, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Zobrazí aktuálně přehrávanou skladbu ve vašem profilu na Discordu" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsDiscordRpcEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Close to tray Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TextCloseToTray, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.TextCloseToTrayDesc, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsCloseToTrayEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Exit App Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.TextExitApp, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.TextExitAppDesc, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{x:Bind ViewModel.ExitApplicationCommand}"
                                                VerticalAlignment="Center"
                                                Padding="16,8"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.TextExitButton, Mode=OneWay}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- App Info Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Melodium" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Nativní WinUI 3 přehrávač pro Windows 11. Svižný, moderní a bez reklam." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="Verze 1.0 (Windows App SDK)" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- VIEW: LOGIN -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Login'}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="520">
                                <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Přihlášení k YouTube Music" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Přihlaste se ke svému Google účtu v samostatném okně pro přístup k osobním playlistům, oblíbeným skladbám a vlastním doporučením."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,10,0,0">
                                    <Button Content="Otevřít přihlašovací okno" Style="{ThemeResource AccentButtonStyle}" Padding="20,10" CornerRadius="20" Click="OnGoToLoginClick" />
                                    <Button Content="Vložit cookies ručně" Padding="20,10" CornerRadius="20" Click="OnMainViewManualCookieClick" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- VIEW: ARTIST PAGE -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Artist'}" RowDefinitions="Auto, *">
                            <ProgressBar Grid.Row="0" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsArtistLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" Height="3" Margin="0,0,0,16" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="28" Padding="0,0,0,40">
                                    
                                    <!-- Back button -->
                                    <Button Click="OnArtistBackClick" Background="Transparent" BorderBrush="Transparent" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                            <TextBlock Text="Zpět" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Artist Hero Header (YouTube Music style) -->
                                    <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                                        <!-- Artist Avatar -->
                                        <Border Grid.Column="0" CornerRadius="70" Width="140" Height="140" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Image Source="{x:Bind ViewModel.CurrentArtist.ThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" Width="140" Height="140" />
                                        </Border>

                                        <!-- Info & Actions -->
                                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center" Spacing="10">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentArtist.Name, Mode=OneWay}" FontSize="34" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            
                                            <TextBlock Text="{x:Bind ViewModel.CurrentArtist.Subscribers, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" Visibility="{x:Bind ViewModel.CurrentArtist.Subscribers, Mode=OneWay, Converter={StaticResource NullToVis}}" />

                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                                <Button Command="{x:Bind ViewModel.PlayArtistTopSongsCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="18,8" CornerRadius="20">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                        <TextBlock Text="Přehrát" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{x:Bind ViewModel.ShuffleArtistSongsCommand}" Padding="18,8" CornerRadius="20">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                                        <TextBlock Text="Zamíchat" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description / Bio -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" MaxWidth="800" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.CurrentArtist.Description, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentArtist.Description, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- Top Songs Section -->
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <TextBlock Text="Populární skladby" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                            <Button Content="Zobrazit všechny" HorizontalAlignment="Right" Click="OnSearchArtistSongsClick" Background="Transparent" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" BorderBrush="Transparent" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentArtist.TopSongs, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:SongModel">
                                                    <Button Style="{StaticResource MediaCardButtonStyle}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Tag="{x:Bind}" DataContext="{x:Bind}"
                                                            Click="OnSongCardClick"
                                                            Padding="10,6"
                                                            CornerRadius="8"
                                                            Margin="0,1">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                                                <MenuFlyoutItem Text="Spustit mix" Icon="Audio" CommandParameter="{x:Bind}" Click="OnSongContextStartMixClick" />
                                                                <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                                                <MenuFlyoutItem Text="Přidat do fronty" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToQueueClick" />
                                                                <MenuFlyoutItem Text="Přidat do playlistu" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToPlaylistClick" />
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="48, *, Auto" VerticalAlignment="Center">
                                                            <Border Grid.Column="0" CornerRadius="6">
                                                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="44" Height="44" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                                <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Tapped="OnSongArtistTapped" Tag="{x:Bind}" ToolTipService.ToolTip="Přejít na autora" />
                                                            </StackPanel>
                                                            <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="12,0,4,0" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <!-- Albums Section -->
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Alba" FontSize="20" FontWeight="Bold" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentArtist.Albums, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="220" MinItemHeight="80" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:AlbumModel">
                                                    <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnAlbumCardClick">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnAlbumContextPlayClick" />
                                                                <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnAlbumContextOpenArtistClick" />
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="64, *">
                                                            <Border Grid.Column="0" CornerRadius="6">
                                                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="64" Height="64" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ReleaseYear}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <!-- Singles Section -->
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Singly a EP" FontSize="20" FontWeight="Bold" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentArtist.Singles, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="220" MinItemHeight="80" MinRowSpacing="12" MinColumnSpacing="12" Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:AlbumModel">
                                                    <Button Style="{StaticResource MediaCardButtonStyle}" Tag="{x:Bind}" DataContext="{x:Bind}" Click="OnAlbumCardClick">
                                                        <Button.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnAlbumContextPlayClick" />
                                                                <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnAlbumContextOpenArtistClick" />
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid ColumnDefinitions="64, *">
                                                            <Border Grid.Column="0" CornerRadius="6">
                                                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" Width="64" Height="64" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ReleaseYear}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- VIEW: PLAYLIST PAGE -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentView, Mode=OneWay, Converter={StaticResource StringToVis}, ConverterParameter='Playlist'}" RowDefinitions="Auto, *">
                            <ProgressBar Grid.Row="0" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsPlaylistLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" Height="3" Margin="0,0,0,16" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="24" Padding="0,0,0,40">
                                    
                                    <!-- Back button -->
                                    <Button Click="OnPlaylistBackClick" Background="Transparent" BorderBrush="Transparent" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                            <TextBlock Text="Zpět" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Playlist Hero Header -->
                                    <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                                        <!-- Playlist Cover -->
                                        <Border Grid.Column="0" CornerRadius="12" Width="140" Height="140" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Image Source="{x:Bind ViewModel.CurrentPlaylist.ThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" Width="140" Height="140" />
                                        </Border>

                                        <!-- Info & Actions -->
                                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Spacing="8">
                                            <!-- Permission Badge -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                        BorderThickness="1" CornerRadius="12" Padding="10,3"
                                                        Visibility="{x:Bind ViewModel.CurrentPlaylist.CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                        <TextBlock Text="Upravitelný playlist" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="12" Padding="10,3"
                                                        Visibility="{x:Bind ViewModel.CurrentPlaylist.CanEdit, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="Sdílený playlist • Pouze ke čtení" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Title -->
                                            <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Title, Mode=OneWay}" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="2" />

                                            <!-- Creator & Count -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Creator, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                                <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="13" />
                                                <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.SongCount, Mode=OneWay}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="skladby" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{x:Bind ViewModel.CurrentPlaylist.Description, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.CurrentPlaylist.Description, Mode=OneWay, Converter={StaticResource NullToVis}}" />

                                            <!-- Actions -->
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                                <Button Command="{x:Bind ViewModel.PlayCurrentPlaylistCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="18,8" CornerRadius="20">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                        <TextBlock Text="Přehrát vše" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{x:Bind ViewModel.ShuffleCurrentPlaylistCommand}" Padding="18,8" CornerRadius="20">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                                        <TextBlock Text="Zamíchat" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Add Song button (only when editable) -->
                                                <Button Padding="18,8" CornerRadius="20"
                                                        Visibility="{x:Bind ViewModel.CurrentPlaylist.CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                        ToolTipService.ToolTip="Hledat a přidat skladbu">
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                            <StackPanel Width="360" Spacing="12" Padding="6">
                                                                <TextBlock Text="Přidat skladbu do playlistu" FontWeight="SemiBold" FontSize="14" />
                                                                <AutoSuggestBox x:Name="AddSongSearchBox"
                                                                                PlaceholderText="Hledat skladbu na YouTube Music..."
                                                                                QueryIcon="Find"
                                                                                QuerySubmitted="OnAddSongSearchSubmitted"
                                                                                TextChanged="OnAddSongSearchTextChanged" />
                                                                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsSearchingSongsToAdd, Mode=OneWay, Converter={StaticResource BoolToVis}}" Height="2" />
                                                                <ListView ItemsSource="{x:Bind ViewModel.PlaylistSearchResults, Mode=OneWay}"
                                                                          MaxHeight="260"
                                                                          SelectionMode="None"
                                                                          IsItemClickEnabled="True"
                                                                          ItemClick="OnSearchResultItemClick">
                                                                    <ListView.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:SongModel">
                                                                            <Grid ColumnDefinitions="36, *, Auto" Margin="0,3">
                                                                                <Border Grid.Column="0" CornerRadius="4">
                                                                                    <Image Source="{x:Bind ThumbnailUrl}" Width="36" Height="36" Stretch="UniformToFill" />
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                                                    <TextBlock Text="{x:Bind Artist}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                                                </StackPanel>
                                                                                <FontIcon Grid.Column="2" Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ListView.ItemTemplate>
                                                                </ListView>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                        <TextBlock Text="Přidat skladbu" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Songs List -->
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Skladby v playlistu" FontSize="18" FontWeight="Bold" />
                                        <ListView ItemsSource="{x:Bind ViewModel.CurrentPlaylistSongs, Mode=OneWay}"
                                                  SelectionMode="None"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="OnPlaylistSongItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:SongModel">
                                                    <Grid ColumnDefinitions="48, *, Auto" Margin="0,3" VerticalAlignment="Center">
                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                                                <MenuFlyoutItem Text="Spustit mix" Icon="Audio" CommandParameter="{x:Bind}" Click="OnSongContextStartMixClick" />
                                                                <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                                                <MenuFlyoutItem Text="Přidat do fronty" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextAddToQueueClick" />
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                                                <MenuFlyoutSeparator Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                                <MenuFlyoutItem Text="Posunout nahoru" Icon="Up" CommandParameter="{x:Bind}" Click="OnPlaylistSongMoveUpClick" Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                                <MenuFlyoutItem Text="Posunout dolů" Icon="Down" CommandParameter="{x:Bind}" Click="OnPlaylistSongMoveDownClick" Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                                <MenuFlyoutItem Text="Odebrat z playlistu" Icon="Delete" CommandParameter="{x:Bind}" Click="OnPlaylistSongRemoveClick" Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>
                                                        <Border Grid.Column="0" CornerRadius="6">
                                                            <Image Source="{x:Bind ThumbnailUrl}" Width="44" Height="44" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                            <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" Tapped="OnSongArtistTapped" Tag="{x:Bind}" ToolTipService.ToolTip="Přejít na autora" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Duration}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{x:Bind Duration, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                                                            <!-- Reorder and remove buttons (only visible if CanEdit) -->
                                                            <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                                <Button Click="OnPlaylistSongMoveUpClick" Tag="{x:Bind}" Background="Transparent" BorderBrush="Transparent" Width="30" Height="30" Padding="0" CornerRadius="15" ToolTipService.ToolTip="Posunout nahoru">
                                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Button>
                                                                <Button Click="OnPlaylistSongMoveDownClick" Tag="{x:Bind}" Background="Transparent" BorderBrush="Transparent" Width="30" Height="30" Padding="0" CornerRadius="15" ToolTipService.ToolTip="Posunout dolů">
                                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Button>
                                                                <Button Click="OnPlaylistSongRemoveClick" Tag="{x:Bind}" Background="Transparent" BorderBrush="Transparent" Width="30" Height="30" Padding="0" CornerRadius="15" ToolTipService.ToolTip="Odebrat z playlistu">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>

        <!-- Bottom Section: Native Modern Docked Player Bar -->
        <Grid Grid.Row="2"
              Height="90"
              Margin="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="0"
              Padding="20,8">
            
            <Grid ColumnDefinitions="280, *, 240">
                
                <!-- Left: Current Song Info -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto, *" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsCurrentSongNotNull, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Border Grid.Column="0" CornerRadius="8">
                        <Image Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}" Width="56" Height="56" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentSong.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <Button Click="OnCurrentSongArtistClick"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="0"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Zobrazit stránku interpreta">
                            <TextBlock Text="{x:Bind ViewModel.CurrentSong.Artist, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="0" Text="Žádná skladba nehraje" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic" FontSize="13" Visibility="{x:Bind ViewModel.IsCurrentSongNull, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <!-- Center: Playback Controls & Timeline -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" MaxWidth="600">
                    <!-- Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                        <!-- Shuffle -->
                        <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                Width="38" Height="38" CornerRadius="19" Padding="0"
                                Background="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBg}}"
                                BorderBrush="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBorder}}"
                                BorderThickness="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBorderThick}}"
                                ToolTipService.ToolTip="Zamíchat frontu">
                            <FontIcon Glyph="&#xE8B1;" FontSize="15" Foreground="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBrush}}" />
                        </Button>

                        <!-- Previous -->
                        <Button Command="{x:Bind ViewModel.PlayPreviousSongCommand}"
                                Width="38" Height="38" CornerRadius="19" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTipService.ToolTip="Předchozí skladba">
                            <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Play/Pause Big Round Button -->
                        <Button Command="{x:Bind ViewModel.PlayPauseCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Width="44" Height="44" CornerRadius="22" Padding="0"
                                ToolTipService.ToolTip="Přehrát / Pozastavit">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="18" />
                        </Button>

                        <!-- Next -->
                        <Button Command="{x:Bind ViewModel.PlayNextSongCommand}"
                                Width="38" Height="38" CornerRadius="19" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTipService.ToolTip="Další skladba">
                            <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Repeat -->
                        <Button Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                                Width="38" Height="38" CornerRadius="19" Padding="0"
                                Background="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBg}}"
                                BorderBrush="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBorder}}"
                                BorderThickness="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBorderThick}}"
                                ToolTipService.ToolTip="Režim opakování">
                            <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" FontSize="15" Foreground="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBrush}}" />
                        </Button>
                    </StackPanel>

                    <!-- Timeline: Position - Slider - Duration -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center" Width="440">
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                Value="{x:Bind ViewModel.PositionSeconds, Mode=TwoWay}"
                                PointerCaptureLost="OnSliderPointerCaptureLost"
                                VerticalAlignment="Center"
                                Height="24" Margin="0" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Right: Tools, Volume & Fullscreen Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Width="85" VerticalAlignment="Center" PointerWheelChanged="OnVolumePointerWheelChanged" />

                    <Button Command="{x:Bind ViewModel.ToggleFullScreenPlayerCommand}"
                            Width="38" Height="38" CornerRadius="19" Padding="0"
                            Background="Transparent" BorderBrush="Transparent"
                            ToolTipService.ToolTip="Otevřít celou obrazovku">
                        <FontIcon Glyph="&#xE740;" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>

            </Grid>
        </Grid>

    <!-- FULLSCREEN PLAYER OVERLAY -->
    <Grid x:Name="FullScreenOverlay"
          Grid.RowSpan="3"
          Visibility="{x:Bind ViewModel.IsFullScreenPlayerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        
        <!-- Backdrop Image and Hardware Blur Layers -->
        <Grid x:Name="BlurBackgroundHost">
            <Image x:Name="BackdropImage" Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill" />
            <Border x:Name="BlurOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Border Background="#A6000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <Grid ColumnDefinitions="6*, 4*" Padding="40">
            
            <!-- Left: Full Player Details -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <!-- Close Fullscreen Button -->
                <Button Grid.Row="0" Command="{x:Bind ViewModel.ToggleFullScreenPlayerCommand}"
                        Width="40" Height="40" CornerRadius="20" Padding="0"
                        Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="Zavřít celou obrazovku">
                    <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" MaxWidth="520">
                    <Border CornerRadius="16">
                        <Image Source="{x:Bind ViewModel.CurrentSong.ThumbnailUrl, Mode=OneWay}" Width="360" Height="360" Stretch="UniformToFill" HorizontalAlignment="Center" />
                    </Border>
                    
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentSong.Title, Mode=OneWay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        <Button Click="OnCurrentSongArtistClick"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="8,4"
                                CornerRadius="6"
                                HorizontalAlignment="Center"
                                ToolTipService.ToolTip="Zobrazit stránku interpreta">
                            <TextBlock Text="{x:Bind ViewModel.CurrentSong.Artist, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Large Timeline -->
                    <Grid ColumnDefinitions="Auto, *, Auto" Width="480">
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}" Value="{x:Bind ViewModel.PositionSeconds, Mode=TwoWay}" PointerCaptureLost="OnSliderPointerCaptureLost" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <!-- Large Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" Margin="0,4,0,0">
                        <!-- Shuffle Button -->
                        <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                Width="46" Height="46" CornerRadius="23" Padding="0"
                                Background="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBg}}"
                                BorderBrush="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBorder}}"
                                BorderThickness="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBorderThick}}"
                                ToolTipService.ToolTip="Zamíchat frontu">
                            <FontIcon Glyph="&#xE8B1;" FontSize="18" Foreground="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToLyricBrush}}" />
                        </Button>

                        <!-- Previous Song -->
                        <Button Command="{x:Bind ViewModel.PlayPreviousSongCommand}"
                                Width="46" Height="46" CornerRadius="23" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTipService.ToolTip="Předchozí skladba">
                            <FontIcon Glyph="&#xE892;" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Play / Pause Main Button -->
                        <Button Command="{x:Bind ViewModel.PlayPauseCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Width="60" Height="60" CornerRadius="30" Padding="0"
                                ToolTipService.ToolTip="Přehrát / Pozastavit">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="24" />
                        </Button>

                        <!-- Next Song -->
                        <Button Command="{x:Bind ViewModel.PlayNextSongCommand}"
                                Width="46" Height="46" CornerRadius="23" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTipService.ToolTip="Další skladba">
                            <FontIcon Glyph="&#xE893;" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Repeat Button -->
                        <Button Command="{x:Bind ViewModel.ToggleRepeatCommand}"
                                Width="46" Height="46" CornerRadius="23" Padding="0"
                                Background="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBg}}"
                                BorderBrush="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBorder}}"
                                BorderThickness="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBorderThick}}"
                                ToolTipService.ToolTip="Režim opakování">
                            <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" FontSize="18" Foreground="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay, Converter={StaticResource BoolToLyricBrush}}" />
                        </Button>

                        <!-- Karaoke Lyrics Toggle Button -->
                        <Button Command="{x:Bind ViewModel.ToggleKaraokeModeCommand}"
                                Width="46" Height="46" CornerRadius="23" Padding="0"
                                Background="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToLyricBg}}"
                                BorderBrush="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToLyricBorder}}"
                                BorderThickness="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToLyricBorderThick}}"
                                ToolTipService.ToolTip="Karaoke text (Lyrics)">
                            <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToLyricBrush}}" />
                        </Button>
                    </StackPanel>

                    <!-- Fullscreen Volume Control -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="0,12,0,0">
                        <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Width="200" VerticalAlignment="Center" PointerWheelChanged="OnVolumePointerWheelChanged" ToolTipService.ToolTip="Hlasitost přehrávání (lze ovládat i kolečkem myši)" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Right: Playback Queue & Karaoke Lyrics -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="24,0,0,0">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                    <!-- Sleek Icon-based Tab Switcher -->
                    <Border Grid.Column="0"
                            Background="#14FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- Queue Tab Button -->
                            <Button Click="OnShowQueueClick"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.QueueCountText, Mode=OneWay}"
                                    Width="42" Height="34"
                                    CornerRadius="17"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToQueueTabBg}}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="15"
                                          Foreground="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToQueueTabFg}}" />
                            </Button>

                            <!-- Karaoke Lyrics Tab Button -->
                            <Button Click="OnShowLyricsClick"
                                    ToolTipService.ToolTip="Karaoke text (Lyrics)"
                                    Width="42" Height="34"
                                    CornerRadius="17"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToLyricsTabBg}}">
                                <FontIcon Glyph="&#xE720;" FontSize="15"
                                          Foreground="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToLyricsTabFg}}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Queue Action: Clear Queue icon button -->
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.ClearQueueCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TextClearQueue, Mode=OneWay}"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Padding="0"
                            Background="#14FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- Lyrics Action: Reload Lyrics icon button -->
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.LoadLyricsForCurrentSongCommand}"
                            ToolTipService.ToolTip="Znovu načíst text"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Padding="0"
                            Background="#14FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- Queue List -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.PlaybackQueue, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedQueueSong, Mode=TwoWay}"
                          ItemClick="OnQueueItemClick"
                          IsItemClickEnabled="True"
                          Visibility="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SongModel">
                            <Grid ColumnDefinitions="48, *, Auto" Margin="0,4" VerticalAlignment="Center">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Přehrát" Icon="Play" CommandParameter="{x:Bind}" Click="OnSongContextPlayClick" />
                                        <MenuFlyoutItem Text="Přehrát jako další" Icon="Add" CommandParameter="{x:Bind}" Click="OnSongContextPlayNextClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Odebrat z fronty" Icon="Cancel" CommandParameter="{x:Bind}" Click="OnSongContextRemoveFromQueueClick" />
                                        <MenuFlyoutItem Text="Přejít na autora" Icon="Contact" CommandParameter="{x:Bind}" Click="OnSongContextOpenArtistClick" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Border Grid.Column="0" CornerRadius="6">
                                    <Image Source="{x:Bind ThumbnailUrl}" Width="44" Height="44" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="8,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Karaoke Lyrics View -->
                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsKaraokeMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE720;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Pro tuto skladbu nebyl nalezen žádný text." FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="Zkuste to znovu nebo vyberte jinou skladbu." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                        <Button Command="{x:Bind ViewModel.LoadLyricsForCurrentSongCommand}" Content="Zkusit znovu" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Synced / Plain Animated Lyrics List -->
                    <ScrollViewer x:Name="LyricsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater x:Name="LyricsItemsRepeater"
                                       ItemsSource="{x:Bind ViewModel.LyricsLines, Mode=OneWay}"
                                       Margin="0,30,16,100">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:LyricLineModel">
                                    <Button Click="OnLyricLineClick"
                                            Tag="{x:Bind}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            CornerRadius="14"
                                            Padding="0"
                                            Margin="0,3">
                                        <Border CornerRadius="14"
                                                Padding="16,10"
                                                HorizontalAlignment="Stretch"
                                                Background="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricBg}}"
                                                BorderBrush="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricBorder}}"
                                                BorderThickness="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricBorderThick}}"
                                                Scale="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricScale}}">
                                            
                                            <!-- Smooth hardware-accelerated scale transition -->
                                            <Border.ScaleTransition>
                                                <Vector3Transition Duration="0:0:0.3" />
                                            </Border.ScaleTransition>

                                            <Grid ColumnDefinitions="Auto, *">
                                                <!-- Glowing active line indicator -->
                                                <Grid Grid.Column="0" Width="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE768;" FontSize="11"
                                                              Foreground="{StaticResource MelodiumAccentBrush}"
                                                              Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                </Grid>

                                                <!-- Lyric line with animated opacity -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Text}"
                                                           FontSize="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricFontSize}}"
                                                           FontWeight="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToFontWeight}}"
                                                           Opacity="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricOpacity}}"
                                                           Foreground="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToLyricBrush}}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.3" />
                                                    </TextBlock.OpacityTransition>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="2" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Loading state overlay -->
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          Visibility="{x:Bind ViewModel.IsLyricsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="48" Height="48" />
                            <TextBlock Text="Načítám text skladby..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Grid>

    </Grid>
</UserControl>
